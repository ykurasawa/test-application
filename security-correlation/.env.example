# ============================================================
# Security Event Correlation App – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ------------------------------------------------------------
# ArcSight ESM
# ------------------------------------------------------------
ARCSIGHT_URL=https://arcsight.example.com:8443
ARCSIGHT_USERNAME=admin
ARCSIGHT_PASSWORD=changeme

# Set to "false" to disable TLS certificate verification
ARCSIGHT_VERIFY_SSL=true

# Optional: URI of the ArcSight Query View resource to use.
# Leave blank to use the default "All Events" view.
# Example: /All Query Views/My Views/Custom Event Query
ARCSIGHT_QUERY_VIEW_URI=

# ------------------------------------------------------------
# Cybereason EDR
# ------------------------------------------------------------
CYBEREASON_URL=https://tenant.cybereason.net
CYBEREASON_USERNAME=analyst@example.com
CYBEREASON_PASSWORD=changeme

# Set to "false" to disable TLS certificate verification
CYBEREASON_VERIFY_SSL=true

# ------------------------------------------------------------
# Correlation Settings
# ------------------------------------------------------------

# Comma-separated list of Cybereason investigationStatus values to process.
# Options: TODO, Pending, UnderInvestigation, OnHold, Closed, Reopened
CORRELATION_STATUS_FILTER=TODO

# Maximum number of MalOps to process per run
CORRELATION_MALOP_LIMIT=25

# Time window (minutes) before and after each MalOp timestamp
CORRELATION_WINDOW_MIN=15

# Set to "false" to skip the Cybereason machine IP enrichment API call
CORRELATION_ENRICH_IPS=true

# Output file path inside the container (mapped via volume in docker-compose)
CORRELATION_OUTPUT_FILE=/app/reports/correlation_report.json
