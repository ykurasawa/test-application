# ============================================================
# Security Event Correlation App – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ------------------------------------------------------------
# ArcSight ESM
# All events (both Cybereason EDR seed events and context events)
# are fetched from this single ArcSight ESM instance.
# ------------------------------------------------------------
ARCSIGHT_URL=https://arcsight.example.com:8443
ARCSIGHT_USERNAME=admin
ARCSIGHT_PASSWORD=changeme

# Set to "false" to disable TLS certificate verification
ARCSIGHT_VERIFY_SSL=true

# Optional: URI of the ArcSight Query View resource to use.
# Leave blank to use the default "All Events" view.
# Example: /All Query Views/My Views/Custom Event Query
ARCSIGHT_QUERY_VIEW_URI=

# ------------------------------------------------------------
# EDR Event Identification
# ArcSight CEF field values used to identify Cybereason EDR events.
# ------------------------------------------------------------

# deviceVendor value for Cybereason EDR events (required)
ARCSIGHT_EDR_VENDOR=Cybereason

# deviceProduct value for Cybereason EDR events (optional; blank = match all products)
ARCSIGHT_EDR_PRODUCT=

# ------------------------------------------------------------
# Correlation Settings
# ------------------------------------------------------------

# How many hours back to look for Cybereason EDR events in ArcSight
CORRELATION_LOOKBACK_HOURS=24

# Maximum number of EDR events to process per run
CORRELATION_EDR_LIMIT=25

# Time window (minutes) before and after each EDR event timestamp
CORRELATION_WINDOW_MIN=15

# Output file path inside the container (mapped via volume in docker-compose)
CORRELATION_OUTPUT_FILE=/app/reports/correlation_report.json
